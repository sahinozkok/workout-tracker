# Bu dosya yalnızca gerekli değişken adlarını gösterir. Gerçek değerleri .env dosyasına yaz.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge Function ve Gemini kurulumu tamamlanana kadar mock bırak.
# Gerçek AI hazır olduğunda değerini gemini yap.
EXPO_PUBLIC_AI_PROVIDER=mock
